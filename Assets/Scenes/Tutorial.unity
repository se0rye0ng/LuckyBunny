--- !u!114 &187909168
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 187909167}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 64af581a28f93d44aa437d8602915916, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  dialogueText: {fileID: 1004972924}
  sentences:
  - "\uBC29\uAC00\uBC29\uAC00, \uC6B0\uB9AC \uC9C0\uAD6C\uC778\uB2D8! \\n\uD5E4\uD5E4,,
    \uB09C \uADF8\uB300 \uC18C\uC6D0\uC744 \uC774\uB904\uC8FC\uB294 \uB7ED\uD0A4
    \uBC84\uB2C8\uC57C!"
  - "\uC74C....  \\n\uD639\uC2DC \uB9C8\uC74C\uC18D\uC5D0 \uC18C\uC911\uD788 \uAC04\uC9C1\uD558\uB358
    \uC18C\uC6D0\uC774 \uC788\uC5B4? \\n\uB098\uD55C\uD14C\uB9CC \uC0B4\uC9DD\uCFF5
    \uC54C\uB824\uC918 \uBD10!"
  - "\uBA4B\uC9C4 \uC18C\uC6D0\uC778\uB370! \\n\uB124 \uC18C\uC6D0\uC744 \uC774\uB904\uC8FC\uB824\uBA74
    \uD2B9\uBCC4\uD55C \uB9C8\uBC95\uC774 \uD544\uC694\uD574...!! \\n\uBC14\uB85C
    \uBC18\uC9DD\uBC18\uC9DD \uBE5B\uB098\uB294 \uB124 \uC78E \uD074\uB85C\uBC84\uC758
    \\n\uD798\uC774 \uD544\uC694\uD558\uB2E8 \uB9D0\uC500!"
  - "\uB124 \uC78E \uD074\uB85C\uBC84\uB97C \uC644\uC131\uD558\uB824\uBA74 \uC138
    \uC7A5\uC758 \uC78E\uC774 \uB354 \uD544\uC694\uD574!\\n\uADF8\uAC78 \uBAA8\uC73C\uB824\uBA74
    \uC2E0\uBE44\uB85C\uC6B4 \uC138 \uD589\uC131\uC73C\uB85C \uBAA8\uD5D8\uC744 \\n\uB5A0\uB098\uC57C
    \uD558\uC9C0!"
  - "\uC5B4\uB514\uBCF4\uC790.. \uBB49\uAC8C\uBB49 \uD589\uC131, \uBBF8\uB044\uB369
    \uD589\uC131, \uB85C\uAFB8\uAEBC \uD589\uC131,,\\n\uD589\uC131\uB9C8\uB2E4 \uC7AC\uBBF8\uC788\uB294
    \uBBF8\uC158\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC9C0. \uCFC4\uCFC4"
  - "\uB108\uB294 \uC138 \uAC1C\uC758 \uD589\uC131\uC744 \uC5EC\uD589\uD558\uBA74\uC11C
    \uC78E\uC744 \uBAA8\uB450 \uBAA8\uC544 \\n\uC644\uBCBD\uD55C \uB124 \uC78E \uD074\uB85C\uBC84\uB97C
    \uB9CC\uB4DC\uB294 \uAC70\uC57C! \\n\uADF8\uB7FC \uB124 \uC18C\uC6D0\uC774 \uB9C8\uBC95\uCC98\uB7FC
    \uC9E0! \uD558\uACE0 \uC774\uB904\uC9C8 \uAC70\uB77C\uAD6C!"
  - "\uC774 \uC5EC\uC815\uC740 \uC27D\uC9C0 \uC54A\uC744\uAC70\uC57C!  \uD558\uC9C0\uB9CC
    \uC751\uC6D0\uD560\uAC8C!"
  - "\uAFB8\uBB3C\uAC70\uB9B4 \uC2DC\uAC04\uC774 \uC5C6\uC5B4! \uBE68\uB9AC\uBE68\uB9AC~~~~~"
  - "\uC790, \uC774\uC81C \uCCAB \uBC88\uC9F8 \uD589\uC131\uC73C\uB85C \uB81B\uCE20
    \uACE0!!!!!"
  typingSpeed: 0.08
  wishInputPanel: {fileID: 1393791327}
  wishInputField: {fileID: 1498838486}
  startImage: {fileID: 0}
